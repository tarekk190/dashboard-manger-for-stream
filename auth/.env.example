PORT=3000
NODE_ENV=production

# Cryptographic secret used for signing viewer JWT tokens (minimum 32 characters)
# Generate with: openssl rand -hex 48
JWT_SECRET=replace_with_min_32_character_secret_generated_via_openssl_rand_hex_48

# Token lifetime in seconds (Short TTL ensures tight anti-leech control)
TOKEN_EXPIRATION_SECONDS=60

# Clock tolerance and network latency grace period in seconds for token renewal
TOKEN_RENEW_GRACE_SECONDS=15

# Allowed CORS Origins (comma separated list, required in production, no wildcard *)
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1
