# ==============================================================================
# Backend environment variables for running server.js OUTSIDE docker compose
# (docker compose reads the root .env instead). Empty values are required.
# ==============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=production

# Admin Control Panel Credentials (ADMIN_PASSWORD: min 12 chars, e.g. openssl rand -base64 24)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT secrets: min 32 chars each, must differ. Generate each with: openssl rand -hex 48
ADMIN_JWT_SECRET=
VIEWER_JWT_SECRET=

# Networking & Ingestion
# The public IP or domain of your VPS where OBS connects
SERVER_IP=
# The public HTTPS domain served by Nginx
EDGE_DOMAIN=
# The custom domain connected to your Cloudflare R2 bucket
R2_CUSTOM_DOMAIN=

# Secret R2 paths: playlists under a rotating key (hd/{slug}/w/{key}/index.html), segments with
# unguessable names. Same value as the data Worker (npx wrangler secret put STREAM_PATH_SECRET).
# Min 32 chars: openssl rand -hex 48. Empty = old public layout (hd/{slug}/index.html).
STREAM_PATH_SECRET=
# Key rotation: a handed-out key works 1-2x this long (hls.js players renew it themselves)
R2_WINDOW_SECONDS=180
# Native HLS (older iOS) cannot switch URLs: its key rotates this slowly instead
R2_NATIVE_WINDOW_SECONDS=7200
# Also keep writing the old public hd/{slug}/index.html (players deployed before this change).
# Set false once the new player/ is live, then block the old path in Cloudflare (deploy/cloudflare-cdn-rules.md).
R2_LEGACY_PLAYLIST=true

# Internal MediaMTX Container Host & Port (Docker network)
MEDIAMTX_RTMP_HOST=mediamtx
MEDIAMTX_RTMP_PORT=1935

# Cloudflare R2 Configuration (S3 Compatible API)
# Leave empty to run in DRY-RUN mode (local storage only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=live-streams
# Optional: if left blank, automatically derived from R2_ACCOUNT_ID
R2_ENDPOINT=

# HLS Directories & Retention
HLS_DIR=/hls
DATA_FILE=/app/data/channels.json
# Segments older than this threshold will be pruned from R2 to keep egress & storage zero-cost
MAX_SEGMENT_AGE_SECONDS=120

# R2 playlist edge cache in seconds. 1 = Cloudflare serves each playlist from cache for 1 s, so R2
# gets ~1 read per cache location per second instead of one per viewer reload. 0 = old no-store.
# Needs the Cloudflare cache rule for /hd/*/index.* set to respect origin Cache-Control (README §5).
R2_PLAYLIST_MAX_AGE=1
# Playlist copies uploaded to R2 per update: html (player R2 mode), css (legacy index.css URL).
R2_PLAYLIST_FILES=html

# Edge Stream Security & Viewer Token Policy (see root .env.example)
ENABLE_AUTH_ON_PLAYLISTS=true
TOKEN_EXPIRATION_SECONDS=45
TOKEN_RENEW_GRACE_SECONDS=10
# off | ua | ua+net | ua+ip  (what a viewer token/session is tied to besides its channel;
# ua+net = User-Agent + the /24 (IPv4) or /48 (IPv6) network of the client)
VIEWER_TOKEN_BIND=ua+net
ALLOWED_ORIGINS=

# Viewer sessions (POST /api/session): Cloudflare Turnstile widget for the player page
# (Cloudflare dashboard -> Turnstile -> Add widget, hostname = EDGE_DOMAIN, mode Invisible or
# Managed). Set both keys or neither; without them any script can open a session.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra hostnames Turnstile may report for the player page (EDGE_DOMAIN is always accepted)
TURNSTILE_HOSTNAMES=
VIEWER_SESSION_SECONDS=1800
# Origin path: segment URLs are signed per channel and window (?e=&s=), valid 1-2 windows
SEGMENT_SIGN_WINDOW_SECONDS=120
# soft = the player stops, clears its source and revokes its session while DevTools is open,
# and restarts with a new session once it is closed. off = no guard.
PLAYER_DEVTOOLS_GUARD=soft
# Per-session limits (0 = off). A session over a limit is revoked; the player passes Turnstile
# again. Networks per session matter for VIEWER_TOKEN_BIND=ua/off (ua+net already pins one).
SESSION_MAX_NETWORKS=2
# /api/stream + /api/r2 + /api/token calls per session and minute (a normal player makes 2-4)
SESSION_MAX_CALLS_PER_MINUTE=20
# New sessions per network and 10 minutes. Off by default (CGNAT); pick a value from the
# admin "viewer sessions" panel (top networks) before turning it on.
MAX_SESSIONS_PER_NETWORK=0

# ------------------------------------------------------------------------------
# Segment encryption (Phase 3): AES-128 on both delivery paths, keys rotate and are handed
# out only to live viewer sessions (inline with /api/r2 and /api/stream, /api/hls-key fallback).
# Rollout: deploy with off -> set HLS_KEY_SECRET and on (with no match live) -> after the
# players opened before that are gone (~1 day), HLS_KEY_LEGACY=false.
# ------------------------------------------------------------------------------
HLS_ENCRYPTION=off
# openssl rand -hex 48 (must differ from the JWT secrets and STREAM_PATH_SECRET; backend only)
HLS_KEY_SECRET=
HLS_KEY_ROTATE_SECONDS=300
# true = keys also for player pages without a key credential (players from before Phase 3)
# and plain origin segments stay reachable. false = strict.
HLS_KEY_LEGACY=true
# on = native iOS HLS (no MediaSource, iOS < 17.1) gets keys through a ticket in its R2
# playlist; off = encrypted streams do not play there
HLS_NATIVE_KEYS=on
