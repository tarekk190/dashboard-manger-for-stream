# ==============================================================================
# Live Streaming Server & Admin Panel Environment Variables
# Copy to .env and adjust values for your production deployment
# ==============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=production

# Admin Control Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_admin_password_123

# JWT Security Secret (Minimum 32 characters)
JWT_SECRET=change_this_to_a_minimum_32_character_cryptographically_secure_jwt_secret

# Networking & Ingestion
# The public IP or domain of your VPS where OBS connects
SERVER_IP=127.0.0.1
# The public HTTPS domain served by Nginx
EDGE_DOMAIN=edge-domain.com
# The custom domain connected to your Cloudflare R2 bucket
R2_CUSTOM_DOMAIN=r2-custom-domain.shop

# Internal MediaMTX Container Host & Port (Docker network)
MEDIAMTX_RTMP_HOST=mediamtx
MEDIAMTX_RTMP_PORT=1935

# Cloudflare R2 Configuration (S3 Compatible API)
# Leave empty or set mock values to run in DRY-RUN mode (local storage only)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_s3_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_s3_secret_access_key_here
R2_BUCKET_NAME=live-streams
# Optional: if left blank, automatically derived from R2_ACCOUNT_ID
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# HLS Directories & Retention
HLS_DIR=/hls
DATA_FILE=/app/data/channels.json
# Segments older than this threshold will be pruned from R2 to keep egress & storage zero-cost
MAX_SEGMENT_AGE_SECONDS=120

# Edge Stream Security & Viewer Token Policy
# Set to 'true' to require ?token= JWT on camouflaged Nginx edge playlists
ENABLE_AUTH_ON_PLAYLISTS=false
TOKEN_EXPIRATION_SECONDS=60
TOKEN_RENEW_GRACE_SECONDS=15
ALLOWED_ORIGINS=*
