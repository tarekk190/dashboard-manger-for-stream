# Environment files
.env
**/.env
*.env.local

# SSL / TLS certificates
certs/*.pem
!certs/.gitkeep
certbot/conf/
certbot/www/*
!certbot/www/.gitkeep

# Runtime data
backend/data/

# Node dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db

# Deployment archives bundle .env and TLS private keys: never commit them
*.zip
*.tar
*.tar.gz
*.tgz

# Wrangler local state (account cache, dev build)
.wrangler/
