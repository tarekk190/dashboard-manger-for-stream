# ==============================================================================
# Live Streaming Infrastructure & Admin Dashboard Stack Environment
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Node Environment
NODE_ENV=production

# Admin Control Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password_123

# JWT Security Secret (Minimum 32 characters, no fallback)
# Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long_for_security

# Network Domains & Public Ingestion Points
# The public IP of your VPS where OBS pushes RTMP
SERVER_IP=127.0.0.1
# The public domain serving Nginx HTTPS edge proxy & player
EDGE_DOMAIN=edge-domain.com
# The custom domain connected to your Cloudflare R2 bucket (Zero-Egress CDN)
R2_CUSTOM_DOMAIN=r2-custom-domain.shop

# Cloudflare R2 Zero-Egress Storage Credentials
# Leave empty to run backend in local DRY-RUN mode
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_s3_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_s3_secret_access_key_here
R2_BUCKET_NAME=live-streams
R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com

# Segment Retention & Pruning
# Segments older than 120 seconds are automatically purged from R2
MAX_SEGMENT_AGE_SECONDS=120

# Edge Stream Security Policy
# Set to 'true' to require ?token= JWT verification on camouflaged Nginx edge playlists
ENABLE_AUTH_ON_PLAYLISTS=false
TOKEN_EXPIRATION_SECONDS=60
