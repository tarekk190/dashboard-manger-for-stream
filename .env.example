# ==============================================================================
# Live Streaming Infrastructure & Admin Dashboard Stack Environment
# Copy this file to .env: cp .env.example .env
# Every value left empty below is REQUIRED: docker compose refuses to start
# without it, and the backend refuses weak values.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Admin Control Panel Credentials (no defaults)
# ADMIN_PASSWORD: at least 12 characters, e.g. generate with: openssl rand -base64 24
ADMIN_USERNAME=
ADMIN_PASSWORD=

# JWT secrets (at least 32 characters each, must be different, no fallback)
# Generate each one with: openssl rand -hex 48
ADMIN_JWT_SECRET=
VIEWER_JWT_SECRET=

# Network Domains & Public Ingestion Points
# The public IP of your VPS where OBS pushes RTMP
SERVER_IP=
# The public domain serving Nginx HTTPS edge proxy & player
EDGE_DOMAIN=
# The custom domain connected to your Cloudflare R2 bucket (Zero-Egress CDN)
R2_CUSTOM_DOMAIN=

# Cloudflare R2 Zero-Egress Storage Credentials
# Leave empty to run backend in local DRY-RUN mode
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=live-streams
R2_ENDPOINT=

# Segment Retention & Pruning
# Segments older than 120 seconds are automatically purged from R2
MAX_SEGMENT_AGE_SECONDS=120

# Edge Stream Security Policy
# ENABLE_AUTH_ON_PLAYLISTS (default true): every edge playlist (.css) AND segment (.js)
# request must carry a viewer token from /api/stream (Authorization: Bearer or ?token=).
# Setting it to false makes /auth allow everything - local debugging only.
ENABLE_AUTH_ON_PLAYLISTS=true
TOKEN_EXPIRATION_SECONDS=60
# An expired token can still be renewed via POST /api/token for this many seconds
TOKEN_RENEW_GRACE_SECONDS=15

# Comma-separated origins allowed to call /api/stream and /api/token cross-origin
# (e.g. https://partner-site.com). Leave empty for same-origin only. '*' is refused in production.
# Playlist/segment CORS is configured separately in nginx/snippets/allowed-origins.conf.
ALLOWED_ORIGINS=
